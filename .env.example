# Patte Configuration (.env)

# Whisper C++ (CTranslate2) Speech-to-Text Settings
# Options: tiny.en (fastest ~450ms), base.en, base (multilingual), small
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# Smart Mode AI Transcript Normalization
AI_REFINEMENT_ENABLED=true

# Output Injection Mode:
# true  = Real-time token streaming via Win32 SendInput (KEYEVENTF_UNICODE)
# false = Full-sentence clipboard paste via Ctrl+V
STREAMING_OUTPUT_ENABLED=true

# AI Provider: lmstudio | groq | openai
AI_PROVIDER=lmstudio

# Local LM Studio Server (127.0.0.1 avoids Windows 2s IPv6 localhost timeout)
LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=s1-mini

# Optional Cloud Providers (for ~150ms LPU cloud speed):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
